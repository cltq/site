{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/navbar/layout,_N_T_/navbar/[route]/layout,_N_T_/navbar/[route]/page,_N_T_/navbar/project"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/navbar/$d$route/__PAGE__",
    "/navbar/$d$route",
    "/navbar",
    "/_index",
    "/_head"
  ]
}