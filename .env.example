# Upstream API base (defaults to https://api.mapleji.xyz)
# UPSTREAM_API=

# Spotify upstream (defaults to https://spotify.mapleji.xyz)
# SPOTIFY_API=

# Last.fm (enables /api/lastfm and the /music page)
LASTFM_API_KEY=
LASTFM_USER=

# Discord webhook for the ask modal (/api/ask)
DISCORD_WEBHOOK_URL=
