---
import Layout from "@/layouts/Layout.astro";
import DiscordWidget from "@/components/DiscordWidget";
import DiscordSkeleton from "@/components/DiscordSkeleton";
import HeroText from "@/components/HeroText";
import SocialIcons from "@/components/SocialIcons.astro";
import NowPlayingPanel from "@/components/NowPlayingPanel";
import AskModalController from "@/components/AskModalController";
---

<Layout>
  <div class="flex flex-col">
    <section
      id="root"
      class="relative flex min-h-svh flex-col items-center justify-center px-6 sm:px-8"
    >
      <div class="flex flex-col items-center gap-6">
        <div class="relative">
          <DiscordWidget showSpotify={false} client:only="react">
            <DiscordSkeleton slot="fallback" />
          </DiscordWidget>
          <div class="absolute top-1/2 left-full ml-6 hidden w-80 -translate-y-1/2 md:block">
            <NowPlayingPanel client:load />
          </div>
        </div>
        <HeroText client:load />
        <SocialIcons />
      </div>
      <div class="mx-auto mt-16 block w-full max-w-xs md:hidden">
        <NowPlayingPanel client:load />
      </div>
    </section>

    <AskModalController client:load />
  </div>
</Layout>
