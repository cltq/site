---
import Layout from "@/layouts/Layout.astro";
import TechStack from "@/components/TechStack.astro";
import GitHubContributions from "@/components/GitHubContributions";

const githubUser = import.meta.env.GITHUB_USERNAME ?? "";
---

<Layout title="development - maple">
  <div class="flex flex-col">
    <section class="flex min-h-svh items-center justify-center px-4 pt-24 pb-16 sm:px-8">
      <div class="flex w-full max-w-4xl flex-col items-center gap-12 text-center sm:gap-16">
        <p class="mb-2 w-full text-left text-xs tracking-widest text-[#737373]">ー development</p>

        <div class="flex w-full flex-col items-center gap-3 sm:gap-4">
          <p class="text-xs tracking-widest text-[#737373]">stacks</p>
          <TechStack />
        </div>

        <div class="flex w-full flex-col items-center gap-4 sm:gap-6">
          <p class="text-xs tracking-widest text-[#737373]">contributions</p>
          <GitHubContributions username={githubUser} client:load />
        </div>
      </div>
    </section>
  </div>
</Layout>
